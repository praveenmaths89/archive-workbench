# Copy to .env. Do not put real secrets in this file.

# Postgres. Docker Compose overrides this so the API talks to the db service.
DATABASE_URL=postgresql+psycopg://archive:archive@localhost:5432/archive
DATA_DIR=./data

# Model access through LiteLLM. Leave the key empty to stay offline:
# Tesseract OCR, extractive answers, and a marked mock translation.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_BASE=
# Optional faster or stronger models for vision OCR tiers. Empty means LLM_MODEL for every tier.
LLM_MODEL_TIER1=
LLM_MODEL_TIER2=
LLM_MODEL_TIER3=
# Still read if LLM_API_KEY is empty, so an older .env keeps working.
ANTHROPIC_API_KEY=

# Per-file upload limit in megabytes. Scanned PDFs are often larger than a web default of 10 MB.
MAX_FILE_MB=500

# tesseract (default, no download), ppocr (printed text; models download on first use),
# claude, or gemini. Vision engines fall back to Tesseract when no key is set.
OCR_ENGINE=tesseract
TESSERACT_LANGS=eng+kan+mar+hin

# local uses intfloat/multilingual-e5-small. api uses EMBEDDING_MODEL via LiteLLM (must be 384 dimensions).
# hash is for tests only.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small

EUROPEANA_API_KEY=
DPLA_API_KEY=

# Sign-in. true skips Google and logs a warning, so a new local install still opens.
# Set false only after GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are filled in.
AUTH_DISABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to generate a secret in DATA_DIR on first sign-in.
AUTH_SECRET=
APP_BASE_URL=http://localhost:3000
# Comma-separated. The admin list is also allowed to sign in.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
ADMIN_EMAILS=praveenmaths89@gmail.com
