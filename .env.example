ANTHROPIC_API_KEY=
# Optional overrides (defaults in app/config.py)
# MODEL_TIER1=claude-haiku-5-5
# MODEL_TIER2=claude-sonnet-5-5
# MODEL_TIER3=claude-opus-5-5
# USE_MOCK=false

# Personal server only. Leave PUBLIC_MODE unset (or false) to keep using your own key.
# PUBLIC_MODE=1 turns off that key, uses local Tesseract, and isolates each browser session.
# PUBLIC_MODE=1
# SESSION_SECRET=
# OCR_ENGINE=tesseract

# Render free web service. Keeps Claude OCR and web search on ANTHROPIC_API_KEY.
# Visitors do not supply a key. Set the key only in the host's secret store.
# HOSTED_MODE=1
# WORKERS=1
