# Copy to .env. Do not put real secrets in this file.

# Postgres. Docker Compose overrides this so the API talks to the db service.
DATABASE_URL=postgresql+psycopg://archive:archive@localhost:5432/archive
DATA_DIR=./data

# Model access through LiteLLM. Leave the key empty to stay offline:
# Tesseract OCR, extractive answers, and a marked mock translation.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_BASE=
# Optional faster or stronger models for vision OCR tiers. Empty means LLM_MODEL for every tier.
LLM_MODEL_TIER1=
LLM_MODEL_TIER2=
LLM_MODEL_TIER3=
# Still read if LLM_API_KEY is empty, so an older .env keeps working.
ANTHROPIC_API_KEY=

# tesseract (default), claude, or gemini. Vision engines fall back to Tesseract when no key is set.
OCR_ENGINE=tesseract
TESSERACT_LANGS=eng+kan+mar+hin

# local uses intfloat/multilingual-e5-small. api uses EMBEDDING_MODEL via LiteLLM (must be 384 dimensions).
# hash is for tests only.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small

EUROPEANA_API_KEY=
DPLA_API_KEY=

# Empty means no login.
APP_PASSWORD=
